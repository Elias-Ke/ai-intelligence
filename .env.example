# Copy this file to .env before running ./start.sh.

# SQLite database
SQLITE_PATH=./data/ai-intelligence.db

# Backend
HOST=127.0.0.1
PORT=3000

# Frontend API proxy
API_PROXY_TARGET=http://127.0.0.1:3000

# AnySearch full-web discovery (optional)
ANYSEARCH_BASE_URL=https://api.anysearch.com
ANYSEARCH_API_KEY=

# OpenAI-compatible LLM for summaries, opportunities and content topics (optional)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
